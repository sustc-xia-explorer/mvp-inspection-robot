Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 35; 39; 48
    Fixed Frame: neupan_sim/map
    Frame Rate: 30
  Name: root
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 14
      Color: 80; 85; 95
      Alpha: 0.4
    - Class: rviz/Map
      Name: Occupancy map
      Enabled: true
      Topic: /neupan_sim/map
      Alpha: 0.5
      Color Scheme: map
    - Class: rviz/MarkerArray
      Name: Walls and obstacles
      Enabled: true
      Marker Topic: /neupan_sim/obstacles
    - Class: rviz/MarkerArray
      Name: FW-mini and status
      Enabled: true
      Marker Topic: /neupan_sim/vehicle
    - Class: rviz/LaserScan
      Name: Simulated scan
      Enabled: true
      Topic: /neupan_sim/scan
      Size (m): 0.035
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 90; 90
      Decay Time: 0
    - Class: rviz/Path
      Name: Global reference
      Enabled: true
      Topic: /neupan_sim/initial_path
      Color: 80; 225; 140
      Line Style: Lines
      Line Width: 0.035
    - Class: rviz/Path
      Name: NeuPAN prediction
      Enabled: true
      Topic: /neupan_sim/neupan_plan
      Color: 255; 180; 60
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz/Path
      Name: Actual trajectory
      Enabled: true
      Topic: /neupan_sim/actual_path
      Color: 70; 175; 255
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz/MarkerArray
      Name: NRMP selected points
      Enabled: false
      Marker Topic: /neupan_sim/nrmp_points
    - Class: rviz/MarkerArray
      Name: DUNE selected points
      Enabled: false
      Marker Topic: /neupan_sim/dune_points
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Show Names: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /neupan_sim/initialpose
    - Class: rviz/SetGoal
      Topic: /neupan_sim/goal
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top view
      Target Frame: <Fixed Frame>
      Scale: 75
      Angle: 0
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
