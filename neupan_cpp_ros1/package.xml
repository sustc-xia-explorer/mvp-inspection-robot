<?xml version="1.0"?>
<package format="2">
  <name>neupan_cpp_ros1</name>
  <version>0.1.0</version>
  <description>ROS Noetic interface for the standalone libneupan planner.</description>
  <maintainer email="robert_kaiyuan@utexas.edu">Kaiyuan Zhang</maintainer>
  <license>GPL-3.0-or-later</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>roslib</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <!-- yhs_can_msgs is required only when running fw_mini_bridge.py. -->
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <!-- libneupan is installed separately and found using CMake CONFIG mode. -->
</package>
